# Database
# For Neon/pooled endpoints, tune the pool explicitly. Prisma's default pool is
# num_cpus*2+1 connections (3 on 1 vCPU) with a 10s timeout, which the
# communication engine's crons + HTTP traffic can exhaust (P2024). Raise it.
# DATABASE_URL="postgresql://postgres:password@localhost:5432/vemtap?connection_limit=15&pool_timeout=20"
DATABASE_URL="postgresql://postgres:password@localhost:5432/vemtap"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_TTL=3600

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-refresh-secret-key-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# App
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"
COOKIE_DOMAIN=".vemtap.com" # Use .yourdomain.com for cross-subdomain cookies

# Payment Providers (Flutterwave/Paystack)
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""

# SMS (Africa's Talking)
AFRICAS_TALKING_API_KEY=""
AFRICAS_TALKING_USERNAME="sandbox"

# KYC Verification APIs
NIN_API_KEY=""
BVN_API_KEY=""

# Email (Resend)
RESEND_API_KEY=""

# Vemtap main-backend integration
# Accepted as the x-api-key header on /external/* and /agents/* endpoints.
VEMTAP_AFFILIATE_KEY=""
# Base URL Vemtap uses to reach this API (informational; host/port binding here).
VEMTAP_AFFILIATE_BASE_URL="http://localhost:4005/api"
# Shared secret for POST /integration/vemtap/payment (x-vemtap-secret header).
VEMTAP_SHARED_SECRET=""

# Web Push (VAPID — generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@vemtap.com"


# Communication System (SMS provider)
# SMS provider identifier, defaults to "disabled" (no actual sends until configured).
# Set in DB (CommunicationSettings.smsProvider) � this is just the reference adapter name.
# Termii example (future): SMS_PROVIDER="termii" ; TERMII_API_KEY="" ; TERMII_SENDER_ID="VEMTAP"
# Africa's Talking example (future): SMS_PROVIDER="africastalking" ; AFRICAS_TALKING_API_KEY=""
SMS_PROVIDER="disabled"
TERMII_API_KEY=""
TERMII_SENDER_ID="VEMTAP"
