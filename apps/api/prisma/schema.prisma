generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  phone           String    @unique
  password        String
  fullName        String
  avatar          String?
  
  referralCode    String    @unique
  referredBy      String?
  referrerId      String?
  referrer        User?     @relation("Referrals", fields: [referrerId], references: [id])
  referrals       User[]    @relation("Referrals")
  
  nin             String?
  bvn             String?
  bankName        String?
  accountNumber   String?
  accountName     String?
  kycStatus       KycStatus @default(PENDING)
  kycDocuments    Json?
  
  totalEarnings   Decimal   @default(0)
  pendingEarnings Decimal   @default(0)
  referralCount   Int       @default(0)
  
  role            Role      @default(AFFILIATE)
  status          UserStatus @default(ACTIVE)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?
  
  businesses      Business[]
  commissions     Commission[]
  withdrawals     Withdrawal[]
  transactions    Transaction[]
  notifications   Notification[]
  trainingProgress TrainingProgress[]
  shortLinks      ShortLink[]
  linkClicks      LinkClick[]
  leads           Lead[]
  fraudAlerts     FraudAlert[] @relation("UserAlerts")
  resolvedAlerts  FraudAlert[] @relation("ResolvedAlerts")
  
  assignedTasks   Task[]       @relation("AssignedTasks")
  agentDemos      Demo[]       @relation("AgentDemos")
  activities      Activity[]
  
  tokenVersion    Int       @default(0)
  paystackSubaccountId String?
  paystackRecipientCode String?
  
  managerQualificationExpiry DateTime?
  isManagerMode             Boolean   @default(false)
  hasClaimedAgentBonus      Boolean   @default(false)
  hasClaimedBusinessBonus   Boolean   @default(false)
  
  signedAgreementVersion    Int?
  signedAt                 DateTime?
  lastLoginIp              String?
  
  tier            Tier      @default(BRONZE)
  newEmail        String?
  emailVerificationCode String?
  emailVerificationExpiry DateTime?

  dailyLeadTarget          Int       @default(0)
  monthlyConversionTarget  Int       @default(0)
  reportingScore           Decimal   @default(100)
  attendanceRate           Decimal   @default(100)
  territoryId              String?
  agreementSignatures      AgreementSignature[]

  isTourCompleted          Boolean   @default(false)
  isOnboardingCompleted    Boolean   @default(false)
  driversLicense           String?
  internationalPassport    String?
  idType                   String?

  marketMappingPlans       MarketMappingPlan[]
  marketMappingNotes       MarketMappingNote[]
  targetAdjustmentLogs     TargetAdjustmentHistory[] @relation("ManagerAdjustments")
  targetAdjustmentsReceived TargetAdjustmentHistory[] @relation("MemberAdjustments")

  @@index([referralCode])
  @@index([referredBy])
  @@index([referrerId])
  @@index([paystackRecipientCode])
  @@index([lastLoginIp])
}

enum Tier {
  BRONZE
  SILVER
  GOLD
}

enum Role {
  AFFILIATE
  ADMIN
  SUPER_ADMIN
  AGENT
  SUPERVISOR
  MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Business {
  id              String    @id @default(uuid())
  
  businessName    String
  ownerName       String
  email           String
  phone           String
  address         String?
  businessType    String?
  planType        PlanType @default(BASIC)
  
  referralCode    String
  affiliateId     String
  affiliate       User       @relation(fields: [affiliateId], references: [id])
  
  subscriptionAmount Decimal
  commissionRate     Decimal  @default(0.15)
  commissionAmount   Decimal  @default(0)
  
  status          BusinessStatus @default(TRIAL)
  trialEndsAt     DateTime?
  paidAt          DateTime?
  lastReminderAt  DateTime?
  healthScore     Int      @default(100)
  churnRisk       String   @default("LOW")
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  commissions     Commission[]
  onboarding      Onboarding?
  
  @@index([affiliateId])
  @@index([referralCode])
  @@index([status])
  @@index([status, createdAt])
}

enum PlanType {
  BASIC
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum BusinessStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

model Commission {
  id              String    @id @default(uuid())
  
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  
  businessId      String?
  business        Business?  @relation(fields: [businessId], references: [id])
  
  subAffiliateId  String?
  
  type            CommissionType
  amount          Decimal
  
  status          CommissionStatus @default(PENDING)
  paidAt          DateTime?
  
  description     String?
  
  createdAt       DateTime  @default(now())
  
  @@index([userId])
  @@index([businessId])
  @@index([status])
  @@index([type])
}

enum CommissionType {
  DIRECT
  INDIRECT
  BONUS
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model Withdrawal {
  id              String    @id @default(uuid())
  
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  
  amount          Decimal
  fee             Decimal    @default(0)
  netAmount       Decimal
  
  bankName        String
  accountNumber   String
  accountName     String
  
  status          WithdrawalStatus @default(PENDING)
  adminNotes      String?
  processedAt     DateTime?
  processedBy     String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  bulkRunId       String?
  bulkRun         BulkWithdrawalRun? @relation(fields: [bulkRunId], references: [id])
  
  @@index([userId])
  @@index([status])
  @@index([bulkRunId])
}

model BulkWithdrawalRun {
  id            String       @id @default(uuid())
  adminId       String
  totalAmount   Decimal
  userCount     Int
  status        String       @default("COMPLETED")
  
  createdAt     DateTime     @default(now())
  withdrawals   Withdrawal[]
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  REJECTED
}

model Transaction {
  id              String    @id @default(uuid())
  
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  
  type            TransactionType
  amount          Decimal
  balanceAfter    Decimal
  description     String?
  
  reference       String    @unique
  
  createdAt       DateTime  @default(now())
  
  @@index([userId])
  @@index([type])
}

enum TransactionType {
  COMMISSION
  WITHDRAWAL
  REFERRAL_BONUS
  ADJUSTMENT
}

model Notification {
  id              String    @id @default(uuid())
  
  userId          String?
  user            User?      @relation(fields: [userId], references: [id])
  
  type            NotificationType
  title           String
  message         String
  
  isRead          Boolean   @default(false)
  readAt          DateTime?
  
  data            Json?
  
  createdAt       DateTime  @default(now())
  
  @@index([userId])
  @@index([isRead])
}

enum NotificationType {
  SYSTEM
  COMMISSION
  WITHDRAWAL
  KYC
  TRAINING
  PROMOTIONAL
}

model TrainingModule {
  id              String    @id @default(uuid())
  
  title           String
  description     String
  content         String
  videoUrl        String?
  
  order           Int
  category        String
  
  isPublished     Boolean   @default(false)
  
  quizzes         Quiz[]
  scenarios       Scenario[]
  progress        TrainingProgress[]
  
  pdfUrl          String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Quiz {
  id              String    @id @default(uuid())
  
  moduleId        String
  module          TrainingModule @relation(fields: [moduleId], references: [id])
  
  question        String
  options         Json
  correctAnswer   Int
  explanation     String?
  
  order           Int
  
  @@index([moduleId])
}

model Scenario {
  id              String    @id @default(uuid())
  
  moduleId        String
  module          TrainingModule @relation(fields: [moduleId], references: [id])
  
  title           String
  situation       String
  objection       String
  idealResponse   String
  
  options         Json?
  correctAnswerIndex Int?
  
  order           Int
  
  @@index([moduleId])
}

model TrainingProgress {
  id              String    @id @default(uuid())
  
  userId          String
  user            User       @relation(fields: [userId], references: [id])
  
  moduleId        String
  module          TrainingModule @relation(fields: [moduleId], references: [id])
  
  status          ProgressStatus @default(NOT_STARTED)
  quizScore       Int?
  practiceResults Json?
  completedAt     DateTime?
  
  startedAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@unique([userId, moduleId])
  @@index([userId])
  @@index([moduleId])
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model PlatformSettings {
  id              String    @id @default(uuid())
  
  directCommissionRate   Decimal @default(0.15)
  indirectCommissionRate Decimal @default(0.05)
  
  minWithdrawal           Decimal @default(5000)
  withdrawalFee           Decimal @default(100)
  
  subAffiliateUnlockCount Int    @default(5)
  
  fraudThresholdScore     Int    @default(80)
  
  referralUnlockCount     Int    @default(0)
  
  earningDurationMonths   Int    @default(12)
  
  agreementTemplate       String?   @db.Text
  agreementVersion        Int       @default(1)
  
  linkExpiryDays          Int       @default(30)
  managerRewardDurationMonths Int    @default(12)
  
  maxIpUsage              Int       @default(2)

  onboardingBonusAmount   Decimal   @default(2500)

  // Promotion requirements
  reqAgentActiveDays             Int      @default(90)
  reqAgentActiveBusinesses       Int      @default(40)
  reqAgentMinReportingScore      Decimal  @default(85.0)
  reqAgentMinAttendanceRate      Decimal  @default(90.0)
  reqAffiliateActiveAgents       Int      @default(30)
  reqAffiliateNetworkBusinesses  Int      @default(100)
  reqSupervisorActiveAgents      Int      @default(10)
  reqSupervisorActiveSupervisors Int      @default(5)
  reqSupervisorNetworkBusinesses Int      @default(100)
  
  updatedAt               DateTime @updatedAt
}

model FraudAlert {
  id              String    @id @default(uuid())
  
  userId          String
  user            User      @relation("UserAlerts", fields: [userId], references: [id], onDelete: Cascade)
  
  type            FraudType
  severity        Severity
  
  description     String
  evidence        Json?
  
  status          FraudStatus @default(OPEN)
  resolvedAt      DateTime?
  resolvedBy      String?
  resolver        User?     @relation("ResolvedAlerts", fields: [resolvedBy], references: [id])
  resolution      String?
  
  createdAt       DateTime  @default(now())
  
  @@index([userId])
  @@index([status])
  @@index([severity])
}

enum FraudType {
  MULTIPLE_ACCOUNTS
  FAKE_REFERRALS
  SELF_REFERRAL
  SUSPICIOUS_ACTIVITY
  KYC_MISMATCH
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum FraudStatus {
  OPEN
  UNDER_REVIEW
  CONFIRMED
  FALSE_POSITIVE
  RESOLVED
}

model AuditLog {
  id              String    @id @default(uuid())
  
  userId          String?
  adminId         String?
  
  action          String
  entity          String
  entityId        String?
  
  oldValue        Json?
  newValue        Json?
  
  ipAddress       String?
  userAgent       String?
  
  createdAt       DateTime  @default(now())
  
  @@index([userId])
  @@index([adminId])
  @@index([entity])
}

model MarketingTool {
  id              String    @id @default(uuid())
  
  title           String
  description     String?
  type            ToolType
  category        String?   // e.g. "Social Media", "Email", "Banners"
  
  content         String    // URL for assets, or text for copy templates
  previewUrl      String?   // Optional thumbnail
  
  isPublished     Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([type])
  @@index([category])
}

enum ToolType {
  BANNER
  EMAIL_SWIPE
  SOCIAL_POST
  VIDEO
  PDF_GUIDE
  LOGO
}

model ApiKey {
  id          String    @id @default(uuid())

  name        String                        // Human-readable label e.g. "Vemtap Production"
  keyHash     String    @unique             // Bcrypt hash of the raw key
  prefix      String                        // First 8 chars of key for display e.g. "vem_k1a2"

  createdById String                        // Admin user who generated the key

  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?

  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  @@index([keyHash])
  @@index([prefix])
  @@index([isActive])
}

model ShortLink {
  id          String   @id @default(uuid())
  code        String   @unique // e.g., "lo"
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([code])
}

model LinkClick {
  id            String    @id @default(uuid())
  
  referralCode  String?   
  shortLinkCode String?   
  
  userId        String?   // Attributed affiliate
  user          User?      @relation(fields: [userId], references: [id])

  ip            String?
  userAgent     String?
  referer       String?
  isQrScan      Boolean   @default(false)
  
  createdAt     DateTime  @default(now())

  @@index([referralCode])
  @@index([shortLinkCode])
  @@index([userId])
  @@index([createdAt])
}

model Lead {
  id              String      @id @default(uuid())
  businessName    String
  industry        String?
  businessAddress String?
  location        String?
  website         String?
  contactName     String?
  contactRole     String?
  phone           String
  email           String?
  source          String?
  otherSource     String?
  priority        Priority    @default(MEDIUM)
  status          LeadStatus  @default(POTENTIAL)
  followUpDate    DateTime?
  comments        String?
  
  affiliateId     String
  affiliate       User        @relation(fields: [affiliateId], references: [id])
  
  assignedAgentId String?     // For Admin use

  demos           Demo[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  @@index([affiliateId])
  @@index([status])
  @@index([priority])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum LeadStatus {
  POTENTIAL
  CONTACTED
  INTERESTED
  NOT_INTERESTED
  COMPLETED
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  priority    Priority @default(MEDIUM)
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?
  
  assignedToId String
  assignedTo   User     @relation("AssignedTasks", fields: [assignedToId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([assignedToId])
  @@index([status])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Demo {
  id           String   @id @default(uuid())
  businessName String
  leadId       String?
  lead         Lead?    @relation(fields: [leadId], references: [id])
  
  date         DateTime
  status       DemoStatus @default(SCHEDULED)
  
  agentId      String
  agent        User     @relation("AgentDemos", fields: [agentId], references: [id])
  
  meetingUrl   String?
  notes        String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([agentId])
  @@index([status])
}

enum DemoStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Onboarding {
  id           String   @id @default(uuid())
  businessId   String   @unique
  business     Business @relation(fields: [businessId], references: [id])
  
  stage        OnboardingStage @default(QR_DESIGN)
  status       OnboardingStatus @default(PENDING)
  
  notes        String?
  
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([businessId])
}

enum OnboardingStage {
  QR_DESIGN
  SHIPMENT
  SETUP
  ACTIVATION
}

enum OnboardingStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

model Activity {
  id          String   @id @default(uuid())
  type        String   // e.g. "demo", "lead", "onboarding", "call", "business"
  title       String
  description String?
  businessName String?
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([type])
}

model Agreement {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  content     String   @db.Text
  targetRoles Role[]   // PostgreSQL enum array of target roles
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  signatures  AgreementSignature[]

  @@index([isActive])
}

model AgreementSignature {
  id          String    @id @default(uuid())
  agreementId String
  agreement   Agreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  version     Int       // The version of the agreement when signed
  signedAt    DateTime  @default(now())

  @@unique([userId, agreementId, version])
  @@index([agreementId])
  @@index([userId])
}

model MarketMappingPlan {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetVisits      Int      @default(0)
  targetLeads       Int      @default(0)
  targetConversions Int      @default(0)
  locationCluster   String?
  status            String   @default("ACTIVE")
  notes             String?
  startDate         DateTime @default(now())
  endDate           DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model MarketMappingNote {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId    String?
  leadId        String?
  businessName  String
  content       String    @db.Text
  followUpDate  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
  @@index([businessId])
  @@index([leadId])
}

model MarketMappingTerritoryConfig {
  id                 String   @id @default(uuid())
  territoryCode      String   @unique
  name               String
  country            String   @default("Nigeria")
  state              String
  city               String
  area               String
  cluster            String
  totalAssigned      Int      @default(0)
  anchorCount        Int      @default(0)
  prospectCount      Int      @default(0)
  anchorsJson        Json?
  priorityVisitsJson Json?
  partnershipsJson   Json?
  maturityJson       Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([territoryCode])
  @@index([cluster])
}

model TargetAdjustmentHistory {
  id                          String   @id @default(uuid())
  managerId                   String
  manager                     User     @relation("ManagerAdjustments", fields: [managerId], references: [id], onDelete: Cascade)
  memberId                    String
  member                      User     @relation("MemberAdjustments", fields: [memberId], references: [id], onDelete: Cascade)
  oldDailyLeadTarget          Int
  newDailyLeadTarget          Int
  oldMonthlyConversionTarget Int
  newMonthlyConversionTarget Int
  reason                      String?
  createdAt                   DateTime @default(now())

  @@index([managerId])
  @@index([memberId])
}


